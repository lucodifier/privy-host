# Copie para .env (o docker compose lê este arquivo automaticamente).

# Porta publicada no servidor/host (dentro do container é sempre 3000). Troque se já estiver em uso.
PRIV_HOST_PORT=3000
# 127.0.0.1 = só esta máquina. Use 0.0.0.0 para acessar pela rede (somente em rede confiável / atrás de proxy HTTPS).
PRIV_HOST_BIND=127.0.0.1

# Usuário root criado na PRIMEIRA execução (se ainda não existir root no banco).
# Sem senha definida, uma senha aleatória é gerada, aparece nos logs e fica em data/root-initial-password.txt
# (troca obrigatória no primeiro login). Alterar estas variáveis depois NÃO muda um root já existente.
PRIV_HOST_ROOT_USER=root
PRIV_HOST_ROOT_PASSWORD=

# Opcional. Se vazio no Docker, a chave é gerada na primeira execução em data/.encryption-key.
# 32 bytes aleatórios em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRIV_HOST_ENCRYPTION_KEY=

# Apenas fora do Docker: pasta do banco SQLite (padrão ./data).
# PRIV_HOST_DATA_DIR=./data
